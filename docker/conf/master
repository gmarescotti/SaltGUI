# /etc/salt/master

file_roots:
  base:
    - /srv/salt/

pillar_roots:
  base:
    - /srv/pillar

external_auth:
  pam:
    salt:
      - .*
      - '@runner'
      - '@wheel'
      - '@jobs'

saltgui_output_formats:
  - table
  - nested
  - json
  - doc
  - saltguihighstate

rest_cherrypy:
    port: 3333
    host: 0.0.0.0
    disable_ssl: true
    app: /saltgui/index.html
    static: /saltgui/static
    static_path: /static

netapi_enable_clients:
    - local
    - local_async
    - runner
    - wheel

saltgui_templates:

    check_acc_versions:
        description: Lista pacchetti TML ACC installati
        target: "*"
        command: pkg.version serverdiag "gwd-serverdiag" linux_cots_x64_diagserver linux_cots_x64_waninterface se_agent se_aligner se_decoder

    read_system_info:
        description: Legge Modello e Versione Macchina
        target: "*"
        command: cmd.run "cat /etc/system_model && cat /etc/system_version && cat /etc/hostname && cat /etc/salt/minion_id"

    test_ping:
        description: test ping
        target: "*"
        command: test.ping

    remove_cdrom_source_list:
        description: commenta il cdrom come repository debian
        target: "*"
        command: cmd.run "sed -i 's/^deb cdrom/#deb cdrom/' /etc/apt/sources.list"

    services_status:
        description: visualizza lo stato dei servizi
        target: "*"
        command: service.status filebeat metricbeat

    check_elk_versions:
        description: Lista pacchetti Elastic Search
        target: "*"
        command: pkg.version filebeat metricbeat

    check_ram:
        description: stampa RAM in gigabyte
        target: "*"
        command: cmd.run "echo $((($(salt-call --local grains.get mem_total --out=txt | awk '{print $2}') + 1024) / 1024)) GB" --timeout=3

    count_exceptions:
        description: conta il numero di "Exception" in ServerDiag.log
        target: "*"
        command: cmd.run "grep Exception /ServerDiag/software/logs/ServerDiag.log | wc -l" --timeout=2

reactor:
  - 'system/alarm':
    - /srv/reactor/alarm_notify.sls

